{
  "config": {
    "step": {
      "user": {
        "title": "Sign in to Home-SmartLink",
        "description": "Use the email and password of the Home-SmartLink mobile app.",
        "data": {
          "email": "[%key:common::config_flow::data::email%]",
          "password": "[%key:common::config_flow::data::password%]"
        }
      },
      "home": {
        "title": "Choose a home",
        "description": "This account has access to several homes.",
        "data": {
          "home_id": "Home"
        }
      }
    },
    "error": {
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "no_home": "This account has no home.",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_account%]"
    }
  },
  "entity": {
    "sensor": {
      "last_connection": {
        "name": "Last connection"
      },
      "status_updated": {
        "name": "Thermostat status update"
      }
    }
  },
  "exceptions": {
    "unsupported_command": {
      "message": "This command is not supported: {error}"
    },
    "command_failed": {
      "message": "Home-SmartLink did not accept the command: {error}"
    }
  }
}
